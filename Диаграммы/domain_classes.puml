@startuml
hide circle
skinparam classAttributeIconSize 0
class User {
 id : UUID
 login : String
 active : boolean
 roles : Set<Role>
 canAct(role) : boolean
}
class Department {
 id : UUID
 name : String
}
class Supplier {
 id : UUID
 name : String
 taxId : String
 active : boolean
}
class PurchaseRequest {
 id : UUID
 number : String
 purpose : String
 status : RequestStatus
 currentRevision : int
 version : long
 createdAt : Instant
 submit()
 recordDecision()
 returnForRevision()
 markOrdered()
}
class RequestRevision {
 revisionNo : int
 frozen : boolean
 submittedAt : Instant [0..1]
 /totalAmount : BigDecimal
 total()
 freeze()
 copyForEdit()
}
class RequestItem {
 id : UUID
 name : String
 quantity : BigDecimal
 unitPrice : BigDecimal
 amount() : BigDecimal
}
class Approval {
 id : UUID
 revisionNo : int
 stage : ApprovalStage
 decision : Decision
 comment : String
 decidedAt : Instant
 recordDecision()
}
class PurchaseOrder {
 id : UUID
 number : String
 status : OrderStatus
 createdAt : Instant
 createFrom(approvedRevision)
}
class AuditEvent {
 id : UUID
 revisionNo : int
 action : String
 occurredAt : Instant
 result : String
 append()
}
User "1" -- "0..*" PurchaseRequest : автор
Department "1" -- "0..*" PurchaseRequest
PurchaseRequest "1" *-- "1..*" RequestRevision
RequestRevision "1" *-- "0..*" RequestItem
RequestRevision "1" -- "0..*" Approval
User "1" -- "0..*" Approval : согласующий
PurchaseRequest "1" -- "0..1" PurchaseOrder : действующий заказ
RequestRevision "1" -- "0..1" PurchaseOrder : утверждённый снимок
Supplier "1" -- "0..*" PurchaseOrder
PurchaseRequest "1" -- "0..*" AuditEvent
User "1" -- "0..*" AuditEvent : инициатор
note bottom of RequestRevision
Позиции: 0..* в редактируемой версии;
1..* в отправленной версии.
После freeze состав и сумма неизменяемы.
end note
@enduml
