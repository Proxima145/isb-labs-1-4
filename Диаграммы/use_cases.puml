@startuml
left to right direction
actor "Сотрудник" as E
actor "Руководитель" as H
actor "Финансовый контролёр" as F
actor "Специалист по закупкам" as B
actor "Администратор справочника" as A
rectangle "Система закупочных заявок" {
usecase "Создать заявку" as Create
usecase "Изменить свою заявку" as Edit
usecase "Отправить или повторно отправить" as Send
usecase "Принять решение" as Decide
usecase "Вернуть на доработку" as Return
usecase "Выбрать поставщика" as Select
usecase "Сформировать заказ" as Order
usecase "Просмотреть историю" as History
usecase "Посмотреть статус" as Status
usecase "Управлять поставщиками" as Suppliers
}
E -- Create
E -- Edit
E -- Send
E -- History
E -- Status
H -- Decide
H -- Return
F -- Decide
F -- Return
B -- Select
B -- Order
A -- Suppliers
@enduml
